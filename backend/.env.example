# -------------------------------------------------------------
# CONFIGURAZIONE AMBIENTE IONOS LINUX VPS
# -------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Database MySQL 8 su IONOS VPS (o localhost se MySQL è installato sullo stesso server)
DATABASE_URL="mysql://db_user_edil:PasswordComplessa123!@127.0.0.1:3306/edil_db?schema=public"

# Sicurezza JWT per Admin
JWT_SECRET="chiave_segreta_lunga_e_complessa_generata_randomicamente_987654"

# Percorso Cartella Upload (Nginx servirà direttamente /uploads da questo percorso)
UPLOAD_DIR="/var/www/edilizia/backend/public/uploads"

# Domini consentiti per CORS (separati da virgola)
ALLOWED_ORIGINS="https://tua-impresa-edile.it,https://www.tua-impresa-edile.it"

# Configurazione SMTP IONOS Mail
SMTP_HOST="smtp.ionos.it"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="notifiche@tua-impresa-edile.it"
SMTP_PASS="PasswordEmailIonos2026!"

# Notifiche Ricezione Lead
COMPANY_ALERT_EMAIL="commerciale@tua-impresa-edile.it"
COMPANY_NAME="EdilPregio Costruzioni s.r.l."
